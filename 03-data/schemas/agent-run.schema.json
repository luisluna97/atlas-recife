{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-recife.local/schemas/agent-run.schema.json",
  "title": "Atlas Agent Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "mission_id",
    "job_id",
    "agent",
    "status",
    "started_at",
    "inputs",
    "outputs",
    "cost"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "0.1.0" },
    "run_id": { "type": "string" },
    "mission_id": { "type": "string" },
    "job_id": { "type": "string" },
    "agent": {
      "type": "object",
      "required": ["id", "contract_version"],
      "properties": {
        "id": { "type": "string" },
        "contract_version": { "type": "string" },
        "model": { "type": ["string", "null"] }
      }
    },
    "status": {
      "enum": ["queued", "running", "succeeded", "failed", "blocked", "cancelled"]
    },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": ["string", "null"], "format": "date-time" },
    "inputs": { "type": "array", "items": { "type": "string" } },
    "outputs": { "type": "array", "items": { "type": "string" } },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "error": { "type": ["object", "null"] },
    "cost": {
      "type": "object",
      "required": ["currency", "estimated_amount"],
      "properties": {
        "currency": { "type": "string", "const": "USD" },
        "estimated_amount": { "type": "number", "minimum": 0 },
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "duration_ms": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "audit_status": {
      "enum": ["not_required", "pending", "approved", "rejected"]
    }
  }
}
